# Mesh Code Formatter (formatter.mesh)
# Formats Mesh code with consistent 4-space indentation, operator spacing, and hygiene.

fn format_line_spacing(line: String) -> String:
    # 1. Normalize comma spacing
    let s = str_replace(line, " ,", ",")
    s = str_replace(s, ",", ", ")
    s = str_replace(s, ",  ", ", ")

    # 2. Normalize arrow spacing
    s = str_replace(s, " ->", " -> ")
    s = str_replace(s, "-> ", " -> ")
    s = str_replace(s, "  ->  ", " -> ")

    # 3. Normalize colons in type annotations and blocks
    s = str_replace(s, " :", ":")
    s = str_replace(s, ":", ": ")
    s = str_replace(s, ":  ", ": ")
    if str_ends_with(s, ": "):
        s = str_slice(s, 0, str_len(s) - 1)
    # Preserve enum variant atom colons
    s = str_replace(s, ": Some", ":Some")
    s = str_replace(s, ": None", ":None")
    s = str_replace(s, ": Ok", ":Ok")
    s = str_replace(s, ": Err", ":Err")
    s = str_replace(s, "Option: Some", "Option:Some")
    s = str_replace(s, "Result: Ok", "Result:Ok")
    s = str_replace(s, "Result: Err", "Result:Err")

    # 4. Normalize binary operator spacing
    s = str_replace(s, " = ", "=")
    s = str_replace(s, "=", " = ")
    s = str_replace(s, " == ", "==")
    s = str_replace(s, "==", " == ")
    s = str_replace(s, " != ", "!=")
    s = str_replace(s, "!=", " != ")
    s = str_replace(s, " <= ", "<=")
    s = str_replace(s, "<=", " <= ")
    s = str_replace(s, " >= ", ">=")
    s = str_replace(s, ">=", " >= ")
    s = str_replace(s, " < ", "<")
    s = str_replace(s, "<", " < ")
    s = str_replace(s, " > ", ">")
    s = str_replace(s, ">", " > ")
    s = str_replace(s, "- >", " -> ")
    s = str_replace(s, " + ", "+")
    s = str_replace(s, "+", " + ")

    # Clean up any accidental double spaces created
    s = str_replace(s, "  ", " ")
    return str_trim(s)

fn format_mesh(source: String) -> String:
    let lines = str_split(source, "\n")
    let total_lines = len(lines)
    let indent_level = 0
    let out = ""
    let prev_blank = false
    let i = 0

    while i < total_lines:
        let raw = lines[i]
        let trimmed = str_trim(raw)

        if str_len(trimmed) == 0:
            if prev_blank == false:
                if str_len(out) > 0:
                    out = out + "\n"
                prev_blank = true
        else:
            prev_blank = false

            # Top-level declarations always reset indent to 0
            if str_starts_with(trimmed, "fn "):
                indent_level = 0
            if str_starts_with(trimmed, "struct "):
                indent_level = 0
            if str_starts_with(trimmed, "enum "):
                indent_level = 0
            if str_starts_with(trimmed, "protocol "):
                indent_level = 0
            if str_starts_with(trimmed, "impl "):
                indent_level = 0
            if str_starts_with(trimmed, "import "):
                indent_level = 0

            # Dedent before line if closing block or else/elif
            let is_dedent = false
            if str_starts_with(trimmed, "else:"):
                is_dedent = true
            if str_starts_with(trimmed, "elif "):
                is_dedent = true
            if str_starts_with(trimmed, "}"):
                is_dedent = true
            if str_starts_with(trimmed, "]"):
                is_dedent = true

            if is_dedent:
                if indent_level > 0:
                    indent_level = indent_level - 1

            let prefix = str_repeat("    ", indent_level)
            let formatted = format_line_spacing(trimmed)
            out = out + prefix + formatted + "\n"

            # Indent after line if block opening
            let is_indent = false
            if str_ends_with(trimmed, ":"):
                is_indent = true
            if str_ends_with(trimmed, "{"):
                is_indent = true

            if is_indent:
                indent_level = indent_level + 1
            else:
                if str_starts_with(trimmed, "return"):
                    if indent_level > 1:
                        indent_level = indent_level - 1

        i = i + 1

    return out

fn main():
    println("Testing formatter.mesh...")
    let unformatted = "fn add(a:Int,b:Int)->Int:\nlet c=a+b\nreturn c\n"
    let formatted = format_mesh(unformatted)
    println("Formatted Output:")
    println(formatted)
